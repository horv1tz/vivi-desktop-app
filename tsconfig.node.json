{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo",
    // Only scripts/*.mjs (plain, untyped build/CI helpers unit-tested from tests/unit/scripts/**)
    // need this; it doesn't pull any other .js/.jsx into the checked set.
    "allowJs": true
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/types/**/*",
    "src/shared/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/voice-worker/**/*",
    "src/acp-bootstrap/**/*",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "tests/unit/**/*",
    "tests/e2e/**/*"
  ]
}
