{
  "name": "vivi",
  "productName": "Vivi",
  "version": "0.3.0",
  "description": "Vivi — personal AI desktop assistant powered by Claude (voice + text, files, web, computer control)",
  "author": {
    "name": "horv1tz",
    "email": "73078166+horv1tz@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/horv1tz/vivi-desktop-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/horv1tz/vivi-desktop-app.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke:agent": "tsx scripts/smoke-agent.ts",
    "icons": "node scripts/gen-icons.mjs",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.81.2",
    "@agentclientprotocol/sdk": "1.5.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "chrome-remote-interface": "^0.34.0",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "6.8.9",
    "fix-path": "^5.0.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "openai": "^7.23.0",
    "proxy-chain": "^3.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sherpa-onnx-node": "^1.13.8",
    "tar": "^7.5.22",
    "unbzip2-stream": "^1.4.3",
    "undici": "^8.11.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "get-windows": "^9.3.0",
    "robotjs": "^0.9.1"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283"
  }
}
